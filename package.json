{
  "name": "conta-facil",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest",
    "test:db:reset": "node -e \"const { spawnSync } = require('node:child_process'); const bash = process.platform === 'win32' ? 'C:/Program Files/Git/bin/bash.exe' : 'bash'; const result = spawnSync(bash, ['scripts/neon-test-reset.sh'], { stdio: 'inherit' }); process.exit(result.status ?? 1)\"",
    "test:integration": "node --env-file=.env.test.local src/test/db-setup.ts",
    "test:integration:schema": "node --env-file=.env.test.local src/test/schema-setup.ts",
    "test:integration:auth": "node --env-file=.env.test.local src/test/auth-middleware-setup.ts",
    "test:integration:lancamentos": "node --env-file=.env.test.local src/test/lancamentos-setup.ts",
    "test:integration:caixinhas": "node --env-file=.env.test.local src/test/caixinhas-setup.ts",
    "test:integration:api-client": "node --env-file=.env.test.local src/test/api-client-setup.ts",
    "test:integration:lancamentos-provider": "node --env-file=.env.test.local node_modules/vitest/vitest.mjs --run src/state/lancamentos-context.integration.test.tsx",
    "test:integration:caixinhas-provider": "node --env-file=.env.test.local node_modules/vitest/vitest.mjs --run src/state/caixinhas-context.integration.test.tsx",
    "test:function:health": "node --input-type=module -e \"const { default: app } = await import('./src/functions/api/index.ts'); const response = await app.request('/health'); const body = await response.json(); if (response.status !== 200 || body.ok !== true) process.exit(1)\"",
    "test:function:deployed": "node --env-file=.env.test.local src/test/function-deployed-setup.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@neon/config": "^1.8.6",
    "@neon/env": "^1.5.3",
    "@neon/functions": "^0.11.0",
    "@neondatabase/auth": "^0.5.0-beta",
    "@radix-ui/react-checkbox": "^1.3.12",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-label": "^2.1.16",
    "@radix-ui/react-slot": "^1.4.0",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "jose": "^6.2.12",
    "lucide-react": "^1.53.0",
    "pg": "^8.23.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.89.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.19.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "drizzle-kit": "^0.31.11",
    "jsdom": "^29.1.1",
    "oxlint": "^1.81.0",
    "postcss": "^8.5.29",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  }
}
